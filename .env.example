# Database (standard Postgres connection string — works with local Postgres, Neon, or self-hosted VPS Postgres)
DATABASE_URL=postgres://payload:payload@localhost:5432/seasonal_picks_hub

# Payload
PAYLOAD_SECRET=replace-with-a-long-random-string

# Public site URL (used for SEO/OG absolute URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hostinger SFTP image storage (production media storage — takes priority over S3
# below if set). Server-side only, never exposed to client code. Files upload to
# <HOSTINGER_SFTP_REMOTE_DIR>/<filename> and are served from HOSTINGER_PUBLIC_BASE_URL.
# HOSTINGER_SFTP_REMOTE_DIR is relative to the SFTP login's home directory, not an
# absolute path — Hostinger multi-domain accounts serve each domain from
# domains/<your-domain>/public_html/, not a bare /public_html at the account root.
# HOSTINGER_SFTP_HOST=
# HOSTINGER_SFTP_PORT=22
# HOSTINGER_SFTP_USERNAME=
# HOSTINGER_SFTP_PASSWORD=
# HOSTINGER_SFTP_REMOTE_DIR=domains/your-domain.com/public_html/media/products
# HOSTINGER_PUBLIC_BASE_URL=https://gettrendyfinds.com/media/products

# Object storage (S3-compatible — Cloudflare R2, AWS S3, or MinIO on VPS).
# Optional fallback: only used if HOSTINGER_SFTP_HOST above is not set. Without
# either set, Media uploads fall back to local disk (fine for dev).
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_REGION=auto

# Amazon Product Advertising API (optional — requires an Associates account that
# has already driven qualifying sales). Without these, "npm run import:links"
# falls back to public HTML/OG/JSON-LD parsing for Amazon links.
# AMAZON_PA_API_ACCESS_KEY=
# AMAZON_PA_API_SECRET_KEY=
# AMAZON_PA_API_ASSOCIATE_TAG=
